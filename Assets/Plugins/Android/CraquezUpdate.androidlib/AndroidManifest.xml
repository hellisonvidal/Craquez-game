<?xml version="1.0" encoding="utf-8"?>
<!-- Atualização por dentro do jogo (instala o APK novo baixado da página de versões) e Android TV. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.hellisonvidal.craquez.update">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <application>
        <provider
            android:name="com.hellisonvidal.craquez.ApkProvider"
            android:authorities="${applicationId}.update"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
